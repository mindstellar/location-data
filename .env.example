# Copy to .env and fill in. .env is gitignored and read automatically by
# tools/r2.py, so no exporting is needed:
#
#     cp .env.example .env && chmod 600 .env
#
# Create the token at Cloudflare dashboard -> R2 -> Manage API tokens, with
# Object Read & Write scoped to the location-data bucket alone. A second
# Object Read Only token is worth making for anything that only consumes
# releases -- an import, a Worker, a restore -- since that one ends up in more
# places and cannot overwrite a release if it leaks.
#
# The account id is not a secret; it appears in every R2 endpoint URL.

R2_ACCOUNT_ID=38f066250e4638d684844d05f1984c80
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Purging the CDN after a release. Optional: without them tools/publish.py
# still publishes and says it did not purge, which is fine for a bucket with no
# CDN in front of it and costs a 60-second wait for the pointer otherwise. A
# --force republish does need them, because it overwrites paths the edge holds
# for 30 days.
#
# A different token from the R2 one: create it at Cloudflare dashboard ->
# Manage Account -> API Tokens with the "Purge Cache" template, scoped to this
# zone alone.
#
# The zone id is on the zone's Overview page. Neither is a bucket credential and
# neither can write to R2.

CF_API_TOKEN=
CF_ZONE_ID=
