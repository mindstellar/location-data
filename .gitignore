.vscode
__pycache__/
.remember/

# Hours of query results. Kept locally, never committed. A copy lives outside
# the repository as well, so that `git clean -fdx` cannot destroy it.
.wikidata_cache/

# Build inputs and outputs: the upstream snapshots are large and
# re-downloadable, and the generated data is written by the scripts here.
countries-states-cities.json
*.nt
*.nt.gz
dump-scan/
dump-build/

# R2 credentials. .env is read automatically by tools/r2.py when it sits in
# the repository root; .env.example is the committed template and carries no
# secret. The trailing patterns catch editor backups and swap files, which
# ".env" alone does not match.
.env
.env.*
!.env.example
.envrc
r2-credentials*
*.env.swp

# Consumer-side findings, kept out of the published repo.
docs/private/
